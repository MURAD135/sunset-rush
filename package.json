{
  "name": "sunset-rush",
  "version": "1.1.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:production": "node tests/production.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:phase1": "node tests/phase1.mjs && node tests/timing.mjs && node tests/classic-baseline.mjs",
    "test:phase2": "node tests/phase2.mjs",
    "test:visuals": "node tests/environment.mjs && node tests/vehicles.mjs && node tests/effects.mjs",
    "test:branding": "node tests/branding.mjs",
    "profile": "node tests/profile.mjs",
    "test:endurance": "node tests/endurance.mjs",
    "prepare:native": "npm run build && node scripts/prepare-native.mjs",
    "test:phase3": "node tests/audio-browser.mjs && node tests/driving-browser.mjs && node tests/save-browser.mjs && node tests/profile-browser.mjs && node tests/power-browser.mjs && node tests/recovery-browser.mjs",
    "test:offline-save": "node tests/offline-save.mjs",
    "test:effects": "node tests/effects.mjs && node tests/effects-comparison.mjs",
    "test:beta": "node tests/vehicles.mjs && node tests/beta-coverage.mjs"
  },
  "dependencies": {
    "three": "0.128.0",
    "cannon-es": "0.20.0"
  },
  "devDependencies": {
    "vite": "6.4.1",
    "playwright": "1.56.1"
  }
}
